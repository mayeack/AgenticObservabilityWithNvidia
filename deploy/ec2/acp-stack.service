[Unit]
Description=Agentic Observability with NVIDIA — blueprint + workshop overlay (docker compose)
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=__BLUEPRINT_DIR__
Environment=WORKSHOP_DIR=__WORKSHOP_DIR__
EnvironmentFile=__WORKSHOP_DIR__/deploy/.env.workshop
ExecStart=/usr/bin/docker compose -f docker-compose.infra.yml -f docker-compose.yml -f docker-compose-nim.yml -f __WORKSHOP_DIR__/deploy/compose/docker-compose.workshop.yml up -d --build
ExecStop=/usr/bin/docker compose -f docker-compose.infra.yml -f docker-compose.yml -f docker-compose-nim.yml -f __WORKSHOP_DIR__/deploy/compose/docker-compose.workshop.yml down
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
