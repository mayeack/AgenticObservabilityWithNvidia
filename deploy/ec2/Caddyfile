# Host-level edge for one workshop box. Rendered by bootstrap.sh (placeholders __HOST__ etc.).
# cloudflared terminates the tunnel and forwards to these local listeners.

# Storefront: basic-auth access key in front of the blueprint's nginx (:80).
http://__HOST__:8080 {
    basicauth {
        acp __ACCESS_KEY_HASH__
    }
    reverse_proxy localhost:80
}

# Optional: publish the Lightning NIM for the hosted Cisco AI Defense Gateway, bearer-gated.
# Leave __NIM_BEARER__ empty to keep the NIM private (local-gateway profile).
http://__NIM_HOST__:8090 {
    @unauthorized not header Authorization "Bearer __NIM_BEARER__"
    respond @unauthorized 401
    reverse_proxy localhost:8010
}
