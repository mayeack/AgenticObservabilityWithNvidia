{
  "title": "Agentic Observability with NVIDIA",
  "description": "NVIDIA Retail Agentic Commerce blueprint: agent spans forwarded over HEC by the OpenTelemetry Collector, and Cisco AI Defense verdicts. Every panel is one click from its events.",
  "inputs": {
    "input_time": { "type": "input.timerange", "title": "Time range", "options": { "token": "global_time", "defaultValue": "-24h@h,now" } },
    "input_env": { "type": "input.dropdown", "title": "Storefront instance", "options": { "token": "env", "defaultValue": "*", "items": [ { "label": "All", "value": "*" }, { "label": "acp1", "value": "acp1" }, { "label": "acp2", "value": "acp2" }, { "label": "acp3", "value": "acp3" } ] } }
  },
  "defaults": { "dataSources": { "ds.search": { "options": { "queryParameters": { "earliest": "$global_time.earliest$", "latest": "$global_time.latest$" } } } } },
  "dataSources": {
    "ds_requests": { "type": "ds.search", "name": "Requests by agent", "options": { "query": "index=acp sourcetype=\"otel:traces\" \"deployment.environment\"=$env$ \"attributes.openinference.span.kind\"=CHAIN | timechart span=5m count BY \"service.name\"" } },
    "ds_latency": { "type": "ds.search", "name": "p95 latency by agent", "options": { "query": "index=acp sourcetype=\"otel:traces\" \"deployment.environment\"=$env$ \"attributes.openinference.span.kind\"=LLM | spath | eval duration_ms=(end_time-start_time)/1000000 | timechart span=5m p95(duration_ms) BY \"service.name\"" } },
    "ds_tokens": { "type": "ds.search", "name": "Tokens by agent", "options": { "query": "index=acp sourcetype=\"otel:traces\" \"deployment.environment\"=$env$ \"attributes.openinference.span.kind\"=LLM | spath | stats sum(\"attributes.llm.token_count.total\") AS tokens BY \"service.name\"" } },
    "ds_verdicts": { "type": "ds.search", "name": "Guardrail verdicts", "options": { "query": "index=acp sourcetype=\"cisco:ai:defense\" | timechart span=5m count BY action" } },
    "ds_blocked_total": { "type": "ds.search", "name": "Blocked prompts", "options": { "query": "index=acp sourcetype=\"cisco:ai:defense\" action=Blocked | stats count" } },
    "ds_requests_total": { "type": "ds.search", "name": "Total requests", "options": { "query": "index=acp sourcetype=\"otel:traces\" \"deployment.environment\"=$env$ \"attributes.openinference.span.kind\"=CHAIN | stats count" } },
    "ds_recent": { "type": "ds.search", "name": "Last 20 traces", "options": { "query": "index=acp sourcetype=\"otel:traces\" \"deployment.environment\"=$env$ \"attributes.openinference.span.kind\"=CHAIN | spath | eval duration_ms=(end_time-start_time)/1000000 | table _time \"service.name\" trace_id duration_ms \"attributes.input.value\" | sort -_time | head 20" } }
  },
  "visualizations": {
    "viz_requests_total": { "type": "splunk.singlevalue", "title": "Agent requests", "dataSources": { "primary": "ds_requests_total" } },
    "viz_blocked_total": { "type": "splunk.singlevalue", "title": "Prompts blocked by Cisco AI Defense", "dataSources": { "primary": "ds_blocked_total" }, "options": { "majorColor": "#FF007F" } },
    "viz_requests": { "type": "splunk.column", "title": "Requests by agent", "dataSources": { "primary": "ds_requests" }, "options": { "stackMode": "stacked" } },
    "viz_latency": { "type": "splunk.line", "title": "p95 LLM latency by agent (ms)", "dataSources": { "primary": "ds_latency" } },
    "viz_tokens": { "type": "splunk.bar", "title": "Tokens by agent", "dataSources": { "primary": "ds_tokens" } },
    "viz_verdicts": { "type": "splunk.column", "title": "Guardrail verdicts over time", "dataSources": { "primary": "ds_verdicts" }, "options": { "stackMode": "stacked" } },
    "viz_recent": { "type": "splunk.table", "title": "Last 20 traces (click a row to correlate)", "dataSources": { "primary": "ds_recent" }, "eventHandlers": [ { "type": "drilldown.customUrl", "options": { "url": "/app/search/search?q=search index%3Dacp (trace_id%3D%22$row.trace_id.value$%22) | spath | sort _time | table _time sourcetype name service.name action classifications attributes.input.value attributes.output.value", "newTab": true } } ] }
  },
  "layout": {
    "type": "grid",
    "options": { "width": 1440, "height": 1100 },
    "globalInputs": [ "input_time", "input_env" ],
    "structure": [
      { "item": "viz_requests_total", "type": "block", "position": { "x": 0, "y": 0, "w": 720, "h": 160 } },
      { "item": "viz_blocked_total", "type": "block", "position": { "x": 720, "y": 0, "w": 720, "h": 160 } },
      { "item": "viz_requests", "type": "block", "position": { "x": 0, "y": 160, "w": 720, "h": 300 } },
      { "item": "viz_latency", "type": "block", "position": { "x": 720, "y": 160, "w": 720, "h": 300 } },
      { "item": "viz_tokens", "type": "block", "position": { "x": 0, "y": 460, "w": 720, "h": 300 } },
      { "item": "viz_verdicts", "type": "block", "position": { "x": 720, "y": 460, "w": 720, "h": 300 } },
      { "item": "viz_recent", "type": "block", "position": { "x": 0, "y": 760, "w": 1440, "h": 340 } }
    ]
  }
}
