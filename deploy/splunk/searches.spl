`comment("Agentic Observability with NVIDIA — Lab 4 searches. Replace index=acp with the workshop index.")`

`comment("4.1.2 Spans from one storefront instance")`
index=acp sourcetype="otel:traces" "deployment.environment"=acp1
| spath
| table _time name "service.name" trace_id span_id "attributes.openinference.span.kind" "attributes.llm.token_count.total"
| sort -_time

`comment("4.1.3 Tokens and latency by agent (LLM spans only)")`
index=acp sourcetype="otel:traces" "attributes.openinference.span.kind"=LLM
| spath
| eval duration_ms = (end_time - start_time) / 1000000
| stats count AS llm_calls sum("attributes.llm.token_count.total") AS tokens p95(duration_ms) AS p95_ms BY "service.name"

`comment("4.2 Cisco AI Defense verdicts (Cisco Security Cloud app, sourcetype cisco:ai:defense)")`
index=acp sourcetype="cisco:ai:defense" action=Blocked
| table _time application connection classifications rules severity event_id
| sort -_time

`comment("4.3 Correlate one session: the trace and the verdict in time order")`
index=acp ("trace_id"="$trace_id$" OR "event_id"="$event_id$")
| spath
| sort _time
| table _time sourcetype name "service.name" action classifications "attributes.input.value" "attributes.output.value"

`comment("Dashboard: requests by agent over time (workflow spans = one request each)")`
index=acp sourcetype="otel:traces" "attributes.openinference.span.kind"=CHAIN
| timechart span=5m count BY "service.name"

`comment("Dashboard: guardrail verdicts over time")`
index=acp sourcetype="cisco:ai:defense"
| timechart span=5m count BY action

`comment("Dashboard: last 20 traces with drilldown into the correlation search")`
index=acp sourcetype="otel:traces" "attributes.openinference.span.kind"=CHAIN
| spath
| eval duration_ms = (end_time - start_time) / 1000000
| table _time "service.name" trace_id duration_ms "attributes.input.value"
| sort -_time | head 20

`comment("Agent log lines shipped by the collector (NAT file logger)")`
index=acp sourcetype="acp:*"
| table _time sourcetype logger sev msg
| sort -_time
