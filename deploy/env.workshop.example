# =============================================================================
# deploy/.env.workshop — every variable the workshop overlay adds.
# Copy to deploy/.env.workshop and fill in. NEVER commit the filled file.
# The blueprint's own `.env` (NVIDIA_API_KEY, NGC_API_KEY, MERCHANT_API_KEY, ...)
# lives in the blueprint checkout as NVIDIA documents; this file is read by the
# four agents and the collector through the overlay's env_file entries.
# =============================================================================

# ---- identity: one name everywhere (agent stream, deployment.environment, tunnel, URL)
WORKSHOP_ENVIRONMENT=acp1
WORKSHOP_DIR=/opt/AgenticObservabilityWithNvidia
WORKSHOP_LOG_DIR=/app/logs

# ---- self-hosted NIMs (blueprint variables; values from deploy/docker-deployment.md)
NGC_API_KEY=
LOCAL_NIM_CACHE=/opt/nim-cache
NIM_LLM_MODEL_NAME=nvidia/nemotron-3.5-lightning
NIM_EMBED_BASE_URL=http://embedqa:8000/v1
NIM_EMBED_MODEL_NAME=nvidia/nemotron-3-embed-1b
NIM_EMBED_DIM=2048

# ---- (b) Cisco AI Defense — the base-URL swap
# Primary: hosted AI Defense Gateway connection fronting the self-hosted NIM.
NIM_LLM_BASE_URL=https://<gateway-host>/<tenant>/<connection>/v1
NVIDIA_API_KEY=<ai-defense-gateway-api-key>
# Fallback (compose --profile local-gateway):
# NIM_LLM_BASE_URL=http://ai-defense-gateway:4000/v1
# NVIDIA_API_KEY=${LITELLM_MASTER_KEY}
CISCO_AI_DEFENSE_API_KEY=
CISCO_AI_DEFENSE_API_BASE=https://us.api.inspect.aidefense.security.cisco.com
LITELLM_MASTER_KEY=sk-workshop-change-me

# ---- (a) Splunk Agent Observability (standalone console tenant)
SPLUNK_AO_CONSOLE_URL=https://console.multitenant.galileocloud.io
SPLUNK_AO_OTEL_ENDPOINT=https://api.multitenant.galileocloud.io/otel/traces
SPLUNK_AO_PROJECT=RetailAgenticCommerce
SPLUNK_AO_AGENT_STREAM=acp1
SPLUNK_AO_API_KEY=
# Realm-based tenant instead? Leave SPLUNK_AO_API_KEY empty, remove the agents'
# `splunk_ao` exporter, and enable otlphttp/splunk_ao in deploy/otel/collector.yaml:
# SPLUNK_AO_REALM=us1
# SPLUNK_AO_O11Y_TOKEN=

# ---- (c) HEC forwarding to Splunk Core (Splunk Show stack: values from /etc/environment on the Show instance)
OTEL_COLLECTOR_ENDPOINT=http://otel-collector:4318/v1/traces
SPLUNK_HEC_URL=https://http-inputs-<stack>.splunkcloud.com:443/services/collector/event
SPLUNK_HEC_TOKEN=
SPLUNK_HEC_INDEX=acp
